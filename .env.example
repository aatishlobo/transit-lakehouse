# 511 Open Transit Data API key -- request at https://511.org/open-data/token
API_511_KEY=

# Consolidated regional feed. 'RG' = all Bay Area real-time agencies in one
# poll, which is what makes the rate limit survivable.
GTFS_AGENCY=RG

# Seconds between poll cycles. THIS IS YOUR ARRIVAL LABEL NOISE FLOOR --
# every arrival timestamp is quantized to this interval. Default 511 budget
# is 60 req/hr; with 2 feed types that caps you at 120s.
POLL_INTERVAL_S=120

# Requests per hour your token is allowed. Raise this after 511 grants an
# increase, then lower POLL_INTERVAL_S to match.
RATE_LIMIT_PER_HOUR=60
